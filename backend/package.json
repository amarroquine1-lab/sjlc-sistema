{
  "name": "sjlc-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrar": "node dist/bd/migrar.js",
    "sembrar:produccion": "node dist/bd/sembrar.js produccion",
