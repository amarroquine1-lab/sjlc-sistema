# Copiar a .env y llenar. El archivo .env nunca se sube a git (permisos 600 en el servidor).

# Zona horaria (todos los contenedores)
TZ=America/Guatemala

# Versión de las imágenes que corre producción (ej. v1.0)
SJLC_VERSION=

# Base de datos
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Contraseña del rol sjlc_app (el que usa la aplicación; el rol se llama así, fijo)
BD_CONTRASENA_APP=

# Entorno: desarrollo | pruebas | produccion
ENTORNO=
# Contraseña de los usuarios ficticios (solo desarrollo y pruebas; nunca en producción)
PRUEBAS_CONTRASENA=

# Backend
PUERTO_BACKEND=3000
# Clave de firma de la sesión: mínimo 32 caracteres aleatorios (por ejemplo: openssl rand -hex 32)
JWT_SECRETO=
DOMINIO=
# Orígenes extra permitidos para peticiones que cambian datos, separados por comas. Vacío = solo el propio sitio
ORIGENES_PERMITIDOS=
# Redes desde las que se confía en la IP que reenvía Nginx. Vacío = redes internas (loopback y privadas)
PROXY_CONFIABLE=

# Los valores con espacios (como los nombres) van entre comillas dobles. No usar $, comillas simples ni \ en los valores.
# Administradores iniciales (seed de producción; deben cambiar la contraseña al primer ingreso)
ADMIN1_USUARIO=
ADMIN1_NOMBRE=
ADMIN1_CONTRASENA_TEMPORAL=
ADMIN2_USUARIO=
ADMIN2_NOMBRE=
ADMIN2_CONTRASENA_TEMPORAL=

# Hora del cierre automático del día, HH:MM de Guatemala (por omisión 20:00)
HORA_CIERRE=
